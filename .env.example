# Copy this file to .env and replace values for your deployment. Existing shell
# environment variables take precedence over values in .env.

# GitHub App credentials. Keep the private key outside version control.
ORCHESTRATOR_GITHUB_APP_ID=123
ORCHESTRATOR_GITHUB_APP_INSTALLATION_ID=123
ORCHESTRATOR_GITHUB_APP_SLUG=bruno303-ai-agent-bot
ORCHESTRATOR_GITHUB_APP_PRIVATE_KEY_FILE=config/key.pem

# Agent model overrides. These take precedence over config/config.yaml.
ORCHESTRATOR_MODEL_EXECUTION_NAME=openai/gpt-5.6-luna
ORCHESTRATOR_MODEL_EXECUTION_VARIANT=medium
ORCHESTRATOR_MODEL_REVIEW_NAME=openai/gpt-5.6-luna
ORCHESTRATOR_MODEL_REVIEW_VARIANT=medium

# Agent executor overrides. Each value is opencode or codex and overrides only
# its matching pipeline executor in config/config.yaml.
ORCHESTRATOR_EXECUTOR_EXECUTION=opencode
ORCHESTRATOR_EXECUTOR_REVIEW=opencode

# Optional filesystem and runtime overrides.
ORCHESTRATOR_CONFIG_FILE=config/config.yaml
ORCHESTRATOR_REPOS_DIR=~/agent-repos
ORCHESTRATOR_WORKSPACES_DIR=~/agent-workspaces
ORCHESTRATOR_DATA_DIR=./data
ORCHESTRATOR_OPENCODE_BIN=opencode
ORCHESTRATOR_OPENCODE_TIMEOUT=3600
# Codex authenticates through its own CLI configuration; no credentials belong here.
ORCHESTRATOR_CODEX_BIN=codex
ORCHESTRATOR_CODEX_TIMEOUT=3600
ORCHESTRATOR_POLL_INTERVAL=300
ORCHESTRATOR_MAX_CONCURRENT=1
ORCHESTRATOR_STALE_SECONDS=7200
